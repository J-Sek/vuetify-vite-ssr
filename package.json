{
  "name": "vite-base",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "run-p type-check build:client build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.ts --outDir dist/server",
    "preview": "NODE_ENV=production tsx server.ts",
    "type-check": "vue-tsc --build --force"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@mdi/font": "7.4.47",
    "hono": "^4.7.10",
    "vue": "^3.5.30",
    "vuetify": "^4.0.2"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.0",
    "npm-run-all2": "^8.0.4",
    "sass-embedded": "^1.98.0",
    "tsx": "^4.19.4",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.2.5"
  },
  "overrides": {}
}
